<UserControl x:Class="SmartX_Telemetry.Views.MeshRoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Mesh Network Topology &amp; Recursive Inspector" Foreground="White" FontSize="20" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,10"/>

        <Button Name="BtnValidateTree" Content="Run Recursive Hierarchy Validation" Background="#007ACC" Foreground="White" 
                BorderThickness="0" Padding="12,8" FontWeight="Bold" Grid.Row="1" HorizontalAlignment="Left" Click="BtnValidateTree_Click" Cursor="Hand" Margin="0,0,0,15"/>

        <!-- Visual representation of the nested IoT network -->
        <TreeView Name="TvNetworkTopology" Grid.Row="2" Background="#252526" Foreground="White" BorderThickness="0" Padding="10">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding NodeName}" Foreground="White" FontSize="14" Margin="2"/>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- Dynamic alert box for validation results -->
        <ListBox Name="LstValidationResults" Grid.Row="3" Height="100" Margin="0,15,0,0" Background="#2D2D30" 
                 Foreground="#FF6B6B" FontFamily="Consolas" BorderThickness="0" Padding="5"/>
    </Grid>
</UserControl>