<Window x:Class="SmartX_Telemetry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X Validation Gateway" Height="600" Width="900"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: The Three Architectural Pillars -->
        <Border Grid.Column="0" Background="#252526" BorderBrush="#333337" BorderThickness="0,0,1,0">
            <StackPanel Margin="10,20,10,10">
                <TextBlock Text="Smart-X Core" Foreground="White" FontSize="20" FontWeight="Bold" Margin="10,0,0,20"/>

                <Button Name="BtnIngestion" Content="Sensor Data Ingestion" Background="#007ACC" Foreground="White" 
                        Height="40" Margin="0,5" BorderThickness="0" Cursor="Hand"/>

                <Button Name="BtnCommandStream" Content="Command Stream (Part 2)" Background="#007ACC" Foreground="White" 
        Height="40" Margin="0,5" BorderThickness="0" Cursor="Hand" Click="BtnCommandStream_Click"/>

                <Button Name="BtnMeshRouting" Content="Mesh Routing (PoE)" Background="#007ACC" Foreground="White" 
        Height="40" Margin="0,5" BorderThickness="0" Cursor="Hand" Click="BtnMeshRouting_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Workspace Area -->
        <Border Grid.Column="1" Background="#1E1E1E" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Telemetry Ingestion Console" Foreground="White" FontSize="24" FontWeight="SemiBold" Grid.Row="0"/>

                <!-- We will inject our user controls into this Frame -->
                <Frame Name="MainFrame" NavigationUIVisibility="Hidden" Grid.Row="1" Margin="0,20,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>